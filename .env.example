# ── Supabase ─────────────────────────────────────────────────────────────────
# Apply supabase/migrations/001_scp_foundation.sql then 002_scp_extended.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App Registration ──────────────────────────────────────────────────────────
# Shared secret for POST /api/apps/register — generate with: openssl rand -hex 32
SCP_REGISTER_SECRET=

# Bearer token for all /api/cron/* routes (Vercel Cron sends Authorization automatically if configured).
# Prefer SCP_CRON_SECRET; CRON_SECRET is accepted as a fallback (e.g. existing Vercel projects).
SCP_CRON_SECRET=
# CRON_SECRET=

# ── LLM Providers (at least one required for /generate) ──────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Vercel / Deployment ───────────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL=https://scp.yourdomain.com

# ── Optional: Default LLM settings ───────────────────────────────────────────
# SCP_DEFAULT_LLM_PROVIDER=openai          # openai | anthropic
# SCP_DEFAULT_LLM_MODEL=gpt-4o             # model name
# SCP_MAX_GENERATION_TOKENS=4096
